{
  "schema": "benchday.plugin.contribution/1",
  "id": "change_count_badge",
  "slot": "work.row.badges",
  "when": {
    "eq": [
      {
        "report": "cli_available"
      },
      {
        "const": true
      }
    ]
  },
  "decoration": {
    "icon": "spec",
    "label": {
      "template": "{0} changes",
      "args": [
        {
          "report": "open_changes"
        }
      ]
    },
    "tone": "info"
  }
}
