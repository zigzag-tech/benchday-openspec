{
  "schema": "benchday.plugin.contribution/1",
  "id": "terminal_badge",
  "slot": "terminal.header.badges",
  "when": {
    "all": [
      {
        "eq": [
          { "report": "openspec_present" },
          { "const": true }
        ]
      },
      {
        "eq": [
          { "report": "cli_available" },
          { "const": true }
        ]
      },
      {
        "not": {
          "exists": "active_change"
        }
      }
    ]
  },
  "decoration": {
    "icon": "spec",
    "label": {
      "const": "OpenSpec"
    },
    "tone": "info",
    "tooltip": {
      "template": "{0} open change(s) \u2014 tap for status",
      "args": [
        {
          "report": "open_changes"
        }
      ]
    }
  },
  "action": "view_status"
}