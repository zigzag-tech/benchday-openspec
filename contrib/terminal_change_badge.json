{
  "schema": "benchday.plugin.contribution/1",
  "id": "terminal_change_badge",
  "slot": "terminal.header.badges",
  "priority": 10,
  "when": {
    "all": [
      {
        "eq": [
          { "report": "openspec_present" },
          { "const": true }
        ]
      },
      {
        "eq": [
          { "report": "cli_available" },
          { "const": true }
        ]
      },
      {
        "exists": "active_change"
      }
    ]
  },
  "decoration": {
    "icon": "tag",
    "label": {
      "template": "{0}",
      "args": [
        {
          "report": "active_change"
        }
      ]
    },
    "tone": "info",
    "progress": {
      "current": {
        "report": "active_change_completed"
      },
      "total": {
        "report": "active_change_total"
      }
    },
    "tooltip": {
      "template": "OpenSpec change: {0} — tap for status",
      "args": [
        {
          "report": "active_change"
        }
      ]
    }
  },
  "action": "view_status"
}
