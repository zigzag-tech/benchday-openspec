{
  "schema": "benchday.plugin.contribution/1",
  "id": "validate_change_detail",
  "slot": "work.detail.actions",
  "priority": -5,
  "when": {
    "all": [
      {
        "eq": [
          {
            "report": "cli_available"
          },
          {
            "const": true
          }
        ]
      },
      {
        "exists": "active_change"
      }
    ]
  },
  "action": "validate_change"
}
