{
  "schema": "benchday.plugin.action/1",
  "id": "view_status",
  "label": "OpenSpec status",
  "icon": "spec",
  "effect": "read",
  "semantic_key": "openspec.view_status",
  "destination": {
    "surface": "extension.web",
    "view": "page"
  },
  "web": {
    "html": {
      "const": "<div id=r></div>\n<script>\n(function () {\n  var raw = window.__BENCHDAY__;\n  var d = raw;\n  var changes = Array.isArray(d) ? d : (d && Array.isArray(d.changes) ? d.changes : []);\n  var active = (d && d.active_change) || null;\n  // Bounded task-checklist projection from the daemon's checklist_md probe\n  // (openspec change surface-openspec-task-detail). `task_outlines` is a phase\n  // rollup + next-attention per change; `focused_task_detail` is the FULL parsed\n  // checklist for the proven associated change ONLY. The page cannot fetch — every\n  // disclosure below reveals data already in this payload.\n  var outlines = (d && Array.isArray(d.task_outlines)) ? d.task_outlines : [];\n  var focused = (d && d.focused_task_detail) || null;\n  var noData = raw == null || (typeof raw === 'object' && !Array.isArray(raw) && Object.keys(raw).length === 0);\n\n  var ctx = window.__BENCHDAY_CONTEXT__ || {};\n  var sum = ctx['surface.summary'] || null;\n  var sumStatus = sum && sum.status ? sum.status : 'unavailable';\n  var rel = window.__BENCHDAY_RELEVANCE__ || {};\n\n  var outlineByName = {};\n  outlines.forEach(function (o) { if (o && o.name) outlineByName[o.name] = o; });\n\n  var esc = function (s) {\n    return String(s == null ? '' : s).replace(/[&<>\"]/g, function (c) {\n      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c];\n    });\n  };\n  var pct = function (c, t) { return t > 0 ? Math.round((c / t) * 100) : 0; };\n  var TAG = { blocked: 'BLOCKED', verify: 'VERIFY', partial: 'PARTIAL', next: 'NEXT' };\n\n  var head = function () {\n    var done = changes.filter(function (c) {\n      return c.total_tasks > 0 && c.completed_tasks >= c.total_tasks;\n    }).length;\n    return '<div class=hd><div class=t>OpenSpec</div>' +\n      '<div class=s>' + changes.length + ' active change' + (changes.length === 1 ? '' : 's') +\n      (done ? ' &middot; ' + done + ' ready to archive' : '') + '</div></div>';\n  };\n\n  if (!changes.length) {\n    var msg = noData\n      ? '<div class=empty><b>No data reached this page.</b><br>' +\n        'The host did not supply <code>web.data</code> &mdash; usually an app build older than the one that parses it.' +\n        '<br><span class=dbg>payload: ' + esc(JSON.stringify(raw)) + '</span></div>'\n      : '<div class=empty>No active changes in this project.</div>';\n    document.getElementById('r').innerHTML = head() + msg;\n    return;\n  }\n\n  // The one attention line shown on a collapsed row. Degradation states carry\n  // their own explicit copy; task progress never manufactures a \"current task\".\n  var attention = function (o, zero) {\n    if (zero) return '<div class=st>No checklist yet</div>';\n    if (!o) return '';\n    var st = o.task_detail_status;\n    if (st === 'absent') return '<div class=st>Task details unavailable &middot; tasks.md not found</div>';\n    if (st === 'unparseable') return '<div class=st>Checklist format not recognized</div>';\n    if (st === 'read_error') return '<div class=st>Task details unavailable</div>';\n    var na = o.next_attention;\n    if (!na) {\n      var vp = o.verify_pending || 0;\n      return '<div class=st>' + (vp ? 'All checked &middot; ' + vp + ' need verification' : 'All tasks checked') + '</div>';\n    }\n    var warn = na.kind === 'verify' || na.kind === 'partial' || na.kind === 'blocked';\n    var idtxt = (na.task_id ? esc(na.task_id) + ' ' : '') + esc(na.text);\n    var ph = o.phases && o.phases[na.phase_index];\n    var phLine = ph ? '<div class=ph>' + esc(ph.title) + ' &middot; ' + (ph.checked || 0) + '/' + (ph.total || 0) + ' checked</div>' : '';\n    return '<div class=\"att' + (warn ? ' warn' : '') + '\"><span class=tag>' + (TAG[na.kind] || 'NEXT') + '</span> ' + idtxt + '</div>' + phLine;\n  };\n\n  var firstUnfinished = function (phases) {\n    for (var i = 0; i < phases.length; i++) if ((phases[i].checked || 0) < (phases[i].total || 0)) return i;\n    return -1;\n  };\n\n  var renderTask = function (t) {\n    var g = t.checked ? '✓' : '○';\n    var tag = t.state === 'unverified' ? '<span class=\"tag warn\">VERIFY</span>'\n      : t.state === 'partial' ? '<span class=\"tag warn\">PARTIAL</span>'\n      : t.state === 'blocked' ? '<span class=\"tag warn\">BLOCKED</span>' : '';\n    var ann = (t.annotations || []).map(function (a) {\n      return '<div class=\"ann' + (a.kind === 'note' ? '' : ' warn') + '\">' + esc(a.text) + '</div>';\n    }).join('');\n    return '<div class=task><span class=\"g' + (t.checked ? ' ok' : '') + '\">' + g + '</span>' +\n      '<div class=tt>' + (t.id ? esc(t.id) + ' ' : '') + esc(t.text) + ' ' + tag + ann + '</div></div>';\n  };\n\n  // The associated change: the full checklist as a phase accordion (one phase\n  // open at a time), the attention phase open by default.\n  var renderFocused = function (o, det) {\n    var byPhase = {};\n    (det.tasks || []).forEach(function (t) { (byPhase[t.phase_index] = byPhase[t.phase_index] || []).push(t); });\n    var attPhase = o && o.next_attention ? o.next_attention.phase_index : -1;\n    var fu = firstUnfinished(o.phases || []);\n    var vp = o.verify_pending || 0;\n    var html = vp ? '<div class=warnbox>⚠ ' + vp + ' checked item' + (vp === 1 ? '' : 's') + ' need verification</div>' : '';\n    (o.phases || []).forEach(function (ph) {\n      var tasks = byPhase[ph.index] || [];\n      var clean = (ph.checked || 0) >= (ph.total || 0) && !ph.verify_pending && !ph.partial;\n      var glyph = clean ? '✓' : (ph.index === fu ? '●' : '○');\n      var verify = ph.verify_pending ? ' &middot; ' + ph.verify_pending + ' verify' : '';\n      var open = ph.index === attPhase ? ' open' : '';\n      html += '<details class=phase' + open + '><summary>' + glyph + ' ' + esc(ph.title) +\n        ' <span class=pc>' + (ph.checked || 0) + '/' + (ph.total || 0) + verify + '</span></summary>' +\n        tasks.map(renderTask).join('') + '</details>';\n    });\n    if (det.truncated) html += '<div class=note>Checklist clipped to the mobile report limit. Counts above still come from OpenSpec.</div>';\n    return html;\n  };\n\n  // A non-associated change expands to phase rollups only (no full body, no fetch).\n  var renderRollup = function (o) {\n    if (!o) return '<div class=note>No checklist detail.</div>';\n    if (o.task_detail_status === 'absent') return '<div class=note>Checklist unavailable &mdash; no readable tasks.md.</div>';\n    if (o.task_detail_status === 'unparseable') return '<div class=note>Checklist format not recognized.</div>';\n    if (!o.phases || !o.phases.length) return '<div class=note>No checklist detail.</div>';\n    return o.phases.map(function (ph) {\n      var clean = (ph.checked || 0) >= (ph.total || 0) && !ph.verify_pending;\n      var glyph = clean ? '✓' : '○';\n      var verify = ph.verify_pending ? ' &middot; ' + ph.verify_pending + ' verify' : '';\n      return '<div class=rollup>' + glyph + ' ' + esc(ph.title) +\n        ' <span class=pc>' + (ph.checked || 0) + '/' + (ph.total || 0) + verify + '</span></div>';\n    }).join('');\n  };\n\n  var row = function (c, kind) {\n    var o = outlineByName[c.name];\n    var isActive = c.name === active;\n    var zero = !(c.total_tasks > 0);\n    var p = pct(c.completed_tasks, c.total_tasks);\n    var complete = c.total_tasks > 0 && c.completed_tasks >= c.total_tasks;\n    var badge = isActive ? '<span class=badge>this pane</span>' : '';\n    var reason = kind === 'suggested' ? '<div class=reason>Related to this pane’s work</div>' : '';\n    var bar = zero ? '' : '<div class=bar><i style=\"width:' + p + '%\" class=\"' + (complete ? 'ok' : '') + '\"></i></div>';\n    var summary =\n      '<div class=r1><span class=nm>' + esc(c.name) + '</span>' + badge +\n      '<span class=ct>' + (c.completed_tasks || 0) + '/' + (c.total_tasks || 0) + '</span></div>' +\n      bar + attention(o, zero) + reason;\n\n    var hasFocused = isActive && focused && focused.name === c.name;\n    var hasRollup = o && o.phases && o.phases.length;\n    if (!hasFocused && !hasRollup) {\n      return '<div class=\"crow' + (isActive ? ' active' : '') + '\">' + summary + '</div>';\n    }\n    var body = hasFocused ? renderFocused(o, focused) : renderRollup(o);\n    var open = hasFocused ? ' open' : '';\n    return '<details class=\"change' + (isActive ? ' active' : '') + '\"' + open + '>' +\n      '<summary class=crow>' + summary + '</summary><div class=body>' + body + '</div></details>';\n  };\n\n  // Three ordered groups (unchanged policy): proven association pins first;\n  // \"suggested\" is only what the hub scored above the floor, best-first; the rest\n  // is a plain alphabetical inventory. Task progress orders NOTHING.\n  var byName = function (a, b) { return String(a.name).localeCompare(String(b.name)); };\n  var associated = changes.filter(function (c) { return c.name === active; });\n  var suggested = changes\n    .filter(function (c) { return c.name !== active && rel[c.name]; })\n    .sort(function (a, b) { return (rel[b.name].score || 0) - (rel[a.name].score || 0); });\n  var picked = {};\n  associated.concat(suggested).forEach(function (c) { picked[c.name] = 1; });\n  var rest = changes.filter(function (c) { return !picked[c.name]; }).sort(byName);\n\n  var notRanked = sumStatus === 'unavailable';\n  var recent = sumStatus === 'stale' ? ' &middot; based on recent work' : '';\n\n  var rows = function (list, kind) { return list.map(function (c) { return row(c, kind); }).join(''); };\n\n  var html = head();\n  if (associated.length) html += rows(associated, 'active');\n  if (suggested.length) {\n    html += '<div class=grp>Suggested for this pane' + recent + '</div>' + rows(suggested, 'suggested');\n  }\n  var anchored = associated.length || suggested.length;\n  if (!anchored) {\n    html += notRanked\n      ? '<div class=note>Not ranked: pane context unavailable.</div>'\n      : '<div class=note>Nothing here is clearly related to this pane.</div>';\n  }\n  if (rest.length) {\n    if (anchored || rest.length > 5) {\n      var label = anchored ? ('Other changes (' + rest.length + ')') : ('Show all ' + rest.length + ' changes');\n      html += '<details class=more><summary>' + label + '</summary>' + rows(rest, '') + '</details>';\n    } else {\n      html += rows(rest, '');\n    }\n  }\n  var r = document.getElementById('r');\n  r.innerHTML = html;\n\n  // One change open at a time (global), and one phase open at a time within a\n  // change. `toggle` does not bubble, so the listener captures. Closing a sibling\n  // programmatically fires another toggle with open=false, which this ignores.\n  r.addEventListener('toggle', function (e) {\n    var t = e.target;\n    if (t.nodeName !== 'DETAILS' || !t.open) return;\n    if (t.classList.contains('change')) {\n      r.querySelectorAll('details.change[open]').forEach(function (o) { if (o !== t) o.open = false; });\n    } else if (t.classList.contains('phase')) {\n      var body = t.parentNode;\n      body.querySelectorAll('details.phase[open]').forEach(function (o) { if (o !== t) o.open = false; });\n    }\n  }, true);\n})();\n</script>\n<style>\n  .hd { margin: 0 0 14px; }\n  .hd .t { font-size: 17px; font-weight: 600; }\n  .hd .s { color: var(--bd-muted); font-size: 13px; }\n  .empty { color: var(--bd-muted); }\n  .dbg { font-size: 11px; opacity: .7; word-break: break-all; }\n  code { font-family: ui-monospace, monospace; }\n  .grp { margin: 16px 0 2px; font-size: 12px; font-weight: 600; letter-spacing: .04em;\n         text-transform: uppercase; color: var(--bd-muted); }\n  .note { margin: 12px 0; padding: 8px 10px; border-radius: var(--bd-radius-sm);\n          background: color-mix(in srgb, var(--bd-muted) 12%, transparent);\n          color: var(--bd-muted); font-size: 12px; }\n  .crow { padding: 10px 0; border-top: 1px solid var(--bd-line); list-style: none;\n          cursor: default; }\n  details.change > summary.crow { cursor: pointer; }\n  details.change > summary::-webkit-details-marker { display: none; }\n  .change.active > summary, .crow.active { border-left: 2px solid var(--bd-primary); padding-left: 10px; }\n  .r1 { display: flex; align-items: baseline; gap: 8px; }\n  .nm { font-weight: 500; word-break: break-word;\n        -webkit-user-select: text; user-select: text; -webkit-touch-callout: default; }\n  .ct { margin-left: auto; color: var(--bd-muted); font-variant-numeric: tabular-nums; font-size: 13px; }\n  .badge { font-size: 11px; padding: 1px 6px; border-radius: var(--bd-radius-sm);\n           background: color-mix(in srgb, var(--bd-primary) 18%, transparent); color: var(--bd-primary); }\n  .bar { height: 3px; margin: 6px 0 4px; background: var(--bd-line); border-radius: var(--bd-radius-sm); overflow: hidden; }\n  .bar i { display: block; height: 100%; background: var(--bd-primary); }\n  .bar i.ok { background: color-mix(in srgb, var(--bd-primary) 70%, #3fb950); }\n  .st { font-size: 12px; color: var(--bd-muted); }\n  .reason { font-size: 12px; color: var(--bd-primary); margin-top: 3px; }\n  .att { font-size: 12px; margin-top: 4px; line-height: 1.35; }\n  .att .tag { font-size: 10px; font-weight: 700; letter-spacing: .05em; color: var(--bd-muted); margin-right: 4px; }\n  .att.warn .tag { color: #d29922; }\n  .ph { font-size: 11px; color: var(--bd-muted); margin-top: 2px; }\n  .body { padding: 4px 0 8px; }\n  .warnbox { font-size: 12px; color: #d29922; margin: 6px 0; }\n  details.phase { margin: 2px 0; }\n  details.phase > summary { cursor: pointer; list-style: none; padding: 6px 0;\n    font-size: 13px; border-top: 1px solid var(--bd-line); }\n  details.phase > summary::-webkit-details-marker { display: none; }\n  .pc { color: var(--bd-muted); font-size: 12px; font-variant-numeric: tabular-nums; }\n  .rollup { font-size: 13px; padding: 5px 0; border-top: 1px solid var(--bd-line); }\n  .task { display: flex; gap: 6px; font-size: 13px; padding: 5px 0 5px 8px; }\n  .task .g { color: var(--bd-muted); flex: 0 0 auto; }\n  .task .g.ok { color: color-mix(in srgb, var(--bd-primary) 70%, #3fb950); }\n  .task .tt { word-break: break-word; }\n  .tag { font-size: 10px; font-weight: 700; letter-spacing: .05em; padding: 0 4px; border-radius: 3px; }\n  .tag.warn { color: #d29922; background: color-mix(in srgb, #d29922 16%, transparent); }\n  .ann { font-size: 11px; color: var(--bd-muted); margin-top: 2px; }\n  .ann.warn { color: #d29922; }\n  .more { margin-top: 14px; }\n  .more > summary { cursor: pointer; list-style: none; padding: 8px 0;\n    font-size: 12px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--bd-muted); }\n  .more > summary::-webkit-details-marker { display: none; }\n  .more > summary::before { content: '\\25B8  '; }\n  .more[open] > summary::before { content: '\\25BE  '; }\n</style>"
    },
    "data": {
      "report": ""
    },
    "context": {
      "version": 1,
      "keys": [
        "surface.summary"
      ]
    },
    "rank": {
      "candidates": "changes",
      "id": "name",
      "text": "name",
      "query": "surface.summary"
    }
  },
  "footer_actions": [
    {
      "action": "choose_change"
    },
    {
      "action": "validate",
      "when": {
        "not": {
          "exists": "active_change"
        }
      }
    },
    {
      "action": "validate_change",
      "when": {
        "exists": "active_change"
      }
    }
  ],
  "popup": {
    "title": {
      "const": "OpenSpec"
    },
    "summary": {
      "template": "{0} active change(s)",
      "args": [
        {
          "report": "open_changes"
        }
      ]
    },
    "empty_state": {
      "const": "No active changes in this project."
    },
    "rows": {
      "items_from": "changes",
      "max_rows": 24,
      "row": {
        "key": {
          "report": "name"
        },
        "primary": {
          "report": "name"
        },
        "secondary": {
          "report": "status"
        },
        "progress": {
          "current": {
            "report": "completed_tasks"
          },
          "total": {
            "report": "total_tasks"
          }
        }
      }
    }
  }
}
