{
  "schema": "benchday.plugin.action/1",
  "id": "view_status",
  "label": "OpenSpec status",
  "icon": "spec",
  "effect": "read",
  "semantic_key": "openspec.view_status",
  "destination": {
    "surface": "extension.web",
    "view": "page"
  },
  "web": {
    "html": {
      "const": "<div id=r></div>\n<script>\n(function () {\n  var raw = window.__BENCHDAY__;\n  var d = raw;\n  var changes = Array.isArray(d) ? d : (d && Array.isArray(d.changes) ? d.changes : []);\n  var active = (d && d.active_change) || null;\n  // Bounded task-checklist projection from the daemon's checklist_md probe\n  // (openspec change surface-openspec-task-detail). `task_outlines` is a phase\n  // rollup + next-attention per change; `focused_task_detail` is the FULL parsed\n  // checklist for the proven associated change ONLY. The page cannot fetch \u2014 every\n  // disclosure below reveals data already in this payload.\n  var outlines = (d && Array.isArray(d.task_outlines)) ? d.task_outlines : [];\n  var focused = (d && d.focused_task_detail) || null;\n  var noData = raw == null || (typeof raw === 'object' && !Array.isArray(raw) && Object.keys(raw).length === 0);\n\n  var ctx = window.__BENCHDAY_CONTEXT__ || {};\n  var sum = ctx['surface.summary'] || null;\n  var sumStatus = sum && sum.status ? sum.status : 'unavailable';\n  var rel = window.__BENCHDAY_RELEVANCE__ || {};\n\n  // With nothing ranked, a short inventory reads fine inline; a long one buries\n  // the view, so it goes behind the same one-tap disclosure the ranked tail uses\n  // (openspec change redesign-openspec-status-view).\n  var INLINE_MAX = 5;\n\n  var outlineByName = {};\n  outlines.forEach(function (o) { if (o && o.name) outlineByName[o.name] = o; });\n\n  var esc = function (s) {\n    return String(s == null ? '' : s).replace(/[&<>\"]/g, function (c) {\n      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c];\n    });\n  };\n  var pct = function (c, t) { return t > 0 ? Math.round((c / t) * 100) : 0; };\n\n  // One state vocabulary, reused everywhere: [icon, label, class]. The icon and\n  // the label are the cues; the tint only reinforces them, so every state stays\n  // readable without colour.\n  var ST = {\n    next: ['\u2192', 'Next', 'is-next'],\n    blocked: ['\u26a0', 'Blocked', 'is-warn'],\n    verify: ['\u2691', 'Verify', 'is-warn'],\n    partial: ['\u25d0', 'Partial', 'is-warn'],\n    ok: ['\u2713', 'All checked', 'is-ok'],\n    info: ['\u2013', '', 'is-info']\n  };\n\n  /** An attention block. `text` is ALREADY escaped; `label` overrides the state's. */\n  var attBlock = function (kind, text, label) {\n    var s = ST[kind] || ST.info;\n    var lab = label == null ? s[1] : label;\n    return '<div class=\"att ' + s[2] + '\">' +\n      '<span class=ico aria-hidden=true>' + s[0] + '</span>' +\n      '<span class=at>' + (lab ? '<span class=lab>' + esc(lab) + '</span>' : '') +\n      (text ? '<span class=txt>' + text + '</span>' : '') + '</span></div>';\n  };\n\n  // The one attention line shown on a collapsed record. Degradation states carry\n  // their own explicit copy; task progress never manufactures a \"current task\".\n  var attention = function (o, zero) {\n    if (zero) return attBlock('info', '', 'No checklist yet');\n    if (!o) return '';\n    var st = o.task_detail_status;\n    if (st === 'absent') return attBlock('info', '&middot; tasks.md not found', 'Task details unavailable');\n    if (st === 'unparseable') return attBlock('info', '', 'Checklist format not recognized');\n    if (st === 'read_error') return attBlock('info', '', 'Task details unavailable');\n    var na = o.next_attention;\n    if (!na) {\n      var vp = o.verify_pending || 0;\n      return vp\n        ? attBlock('verify', 'All checked &middot; ' + vp + ' need verification')\n        : attBlock('ok', '');\n    }\n    var kind = ST[na.kind] ? na.kind : 'next';\n    var idtxt = (na.task_id ? esc(na.task_id) + ' ' : '') + esc(na.text);\n    var ph = o.phases && o.phases[na.phase_index];\n    var phLine = ph ? '<div class=meta>' + esc(ph.title) + ' &middot; ' + (ph.checked || 0) + '/' + (ph.total || 0) + ' checked</div>' : '';\n    return attBlock(kind, idtxt) + phLine;\n  };\n\n  var firstUnfinished = function (phases) {\n    for (var i = 0; i < phases.length; i++) if ((phases[i].checked || 0) < (phases[i].total || 0)) return i;\n    return -1;\n  };\n\n  var renderTask = function (t) {\n    var g = t.checked ? '\u2713' : '\u25cb';\n    var tag = t.state === 'unverified' ? '<span class=\"tag warn\">Verify</span>'\n      : t.state === 'partial' ? '<span class=\"tag warn\">Partial</span>'\n        : t.state === 'blocked' ? '<span class=\"tag warn\">Blocked</span>' : '';\n    var ann = (t.annotations || []).map(function (a) {\n      return '<div class=\"ann' + (a.kind === 'note' ? '' : ' warn') + '\">' + esc(a.text) + '</div>';\n    }).join('');\n    return '<div class=task><span class=\"g' + (t.checked ? ' ok' : '') + '\" aria-hidden=true>' + g + '</span>' +\n      '<div class=tt>' + (t.id ? esc(t.id) + ' ' : '') + esc(t.text) + ' ' + tag + ann + '</div></div>';\n  };\n\n  // The associated change: the full checklist as a phase accordion (one phase\n  // open at a time), the attention phase open by default.\n  var renderFocused = function (o, det) {\n    var byPhase = {};\n    (det.tasks || []).forEach(function (t) { (byPhase[t.phase_index] = byPhase[t.phase_index] || []).push(t); });\n    var attPhase = o && o.next_attention ? o.next_attention.phase_index : -1;\n    var fu = firstUnfinished(o.phases || []);\n    var vp = o.verify_pending || 0;\n    var html = vp ? '<div class=\"note warn\">\u26a0 ' + vp + ' checked item' + (vp === 1 ? ' needs' : 's need') + ' verification</div>' : '';\n    (o.phases || []).forEach(function (ph) {\n      var tasks = byPhase[ph.index] || [];\n      var clean = (ph.checked || 0) >= (ph.total || 0) && !ph.verify_pending && !ph.partial;\n      var glyph = clean ? '\u2713' : (ph.index === fu ? '\u25cf' : '\u25cb');\n      var verify = ph.verify_pending ? ' &middot; ' + ph.verify_pending + ' verify' : '';\n      var open = ph.index === attPhase ? ' open' : '';\n      html += '<details class=phase' + open + '><summary><span class=pg aria-hidden=true>' + glyph + '</span>' +\n        '<span class=pt>' + esc(ph.title) + '</span>' +\n        '<span class=pc>' + (ph.checked || 0) + '/' + (ph.total || 0) + verify + '</span>' +\n        '<span class=chev aria-hidden=true></span></summary>' +\n        '<div class=tasks>' + tasks.map(renderTask).join('') + '</div></details>';\n    });\n    if (det.truncated) html += '<div class=note>Checklist clipped to the mobile report limit. Counts above still come from OpenSpec.</div>';\n    return html;\n  };\n\n  // A non-associated change expands to phase rollups only (no full body, no fetch).\n  var renderRollup = function (o) {\n    if (!o) return '<div class=note>No checklist detail.</div>';\n    if (o.task_detail_status === 'absent') return '<div class=note>Checklist unavailable \u2014 no readable tasks.md.</div>';\n    if (o.task_detail_status === 'unparseable') return '<div class=note>Checklist format not recognized.</div>';\n    if (!o.phases || !o.phases.length) return '<div class=note>No checklist detail.</div>';\n    return o.phases.map(function (ph) {\n      var clean = (ph.checked || 0) >= (ph.total || 0) && !ph.verify_pending;\n      var glyph = clean ? '\u2713' : '\u25cb';\n      var verify = ph.verify_pending ? ' &middot; ' + ph.verify_pending + ' verify' : '';\n      return '<div class=rollup><span class=pg aria-hidden=true>' + glyph + '</span>' +\n        '<span class=pt>' + esc(ph.title) + '</span>' +\n        '<span class=pc>' + (ph.checked || 0) + '/' + (ph.total || 0) + verify + '</span></div>';\n    }).join('');\n  };\n\n  // Every change is ONE bounded record: identity, progress, attention, phase\n  // context, evidence. Collapsed or expanded, the outline is the boundary.\n  var row = function (c, kind) {\n    var o = outlineByName[c.name];\n    var isActive = c.name === active;\n    var zero = !(c.total_tasks > 0);\n    var p = pct(c.completed_tasks, c.total_tasks);\n    var complete = c.total_tasks > 0 && c.completed_tasks >= c.total_tasks;\n    var badge = isActive ? '<span class=badge>This pane</span>' : '';\n    var reason = kind === 'suggested' ? '<div class=why>Related to this pane\u2019s work</div>' : '';\n    var bar = zero ? '' : '<div class=bar role=presentation><i style=\"width:' + p + '%\" class=\"' + (complete ? 'ok' : '') + '\"></i></div>';\n\n    var hasFocused = isActive && focused && focused.name === c.name;\n    var hasRollup = o && o.phases && o.phases.length;\n    var expandable = hasFocused || hasRollup;\n\n    var summary =\n      '<div class=idn><span class=nm>' + esc(c.name) + '</span>' + badge +\n      '<span class=ct>' + (c.completed_tasks || 0) + '/' + (c.total_tasks || 0) + '</span>' +\n      (expandable ? '<span class=chev aria-hidden=true></span>' : '') + '</div>' +\n      bar + attention(o, zero) + reason;\n\n    if (!expandable) {\n      return '<div class=\"crow flat' + (isActive ? ' active' : '') + '\">' + summary + '</div>';\n    }\n    var body = hasFocused ? renderFocused(o, focused) : renderRollup(o);\n    var open = hasFocused ? ' open' : '';\n    return '<details class=\"change' + (isActive ? ' active' : '') + '\"' + open + '>' +\n      '<summary class=crow>' + summary + '</summary><div class=body>' + body + '</div></details>';\n  };\n\n  // Three ordered groups (unchanged policy): proven association pins first;\n  // \"suggested\" is only what the hub scored above the floor, best-first; the rest\n  // is a plain alphabetical inventory. Task progress orders NOTHING.\n  var byName = function (a, b) { return String(a.name).localeCompare(String(b.name)); };\n  var associated = changes.filter(function (c) { return c.name === active; });\n  var suggested = changes\n    .filter(function (c) { return c.name !== active && rel[c.name]; })\n    .sort(function (a, b) { return (rel[b.name].score || 0) - (rel[a.name].score || 0); });\n  var picked = {};\n  associated.concat(suggested).forEach(function (c) { picked[c.name] = 1; });\n  var rest = changes.filter(function (c) { return !picked[c.name]; }).sort(byName);\n\n  var notRanked = sumStatus === 'unavailable';\n  // A screen-derived summary (bind-hookless-agent-panes Tier 3) ranks like any\n  // present value but is LABELLED so the order never poses as proven work, and it\n  // never pins association (that is `active` from active_change, not this).\n  var screenDerived = sum && sum.reason === 'screen_derived';\n  var recent = sumStatus === 'stale' ? ', based on recent work' : (screenDerived ? ', based on on-screen content' : '');\n\n  // Zone 1: what state the project is in. Two counts do not justify card chrome,\n  // and the sheet chrome already titles this \"OpenSpec status\".\n  var summaryLine = function () {\n    var done = changes.filter(function (c) {\n      return c.total_tasks > 0 && c.completed_tasks >= c.total_tasks;\n    }).length;\n    return '<div class=sum>' + changes.length + ' active change' + (changes.length === 1 ? '' : 's') +\n      (done ? ' <span class=dot>&middot;</span> ' + done + ' ready to archive' : '') + '</div>';\n  };\n\n  if (!changes.length) {\n    var msg = noData\n      ? '<div class=empty><b>No data reached this page.</b><br>' +\n        'The host did not supply <code>web.data</code> &mdash; usually an app build older than the one that parses it.' +\n        '<br><span class=dbg>payload: ' + esc(JSON.stringify(raw)) + '</span></div>'\n      : '<div class=empty>No active changes in this project.</div>';\n    document.getElementById('r').innerHTML = summaryLine() + msg;\n    return;\n  }\n\n  // Zone 2: why the list is ordered the way it is. Explanatory metadata \u2014 never\n  // a section heading, never a change record.\n  var notice = function () {\n    var t;\n    if (notRanked) t = 'Not ranked \u2014 no pane context. Listed alphabetically.';\n    else if (associated.length && suggested.length) t = 'This pane\u2019s change first, then changes related to its work' + recent + '.';\n    else if (associated.length) t = 'Pinned to the change proven for this pane.';\n    else if (suggested.length) t = 'Ordered by relation to this pane\u2019s work' + recent + '.';\n    else t = 'Nothing is clearly tied to this pane. Listed alphabetically.';\n    return '<div class=notice>' + t + '</div>';\n  };\n\n  var rows = function (list, kind) { return list.map(function (c) { return row(c, kind); }).join(''); };\n\n  // Zone 3: named groups of bounded records.\n  var html = summaryLine() + notice();\n  if (associated.length) {\n    html += '<div class=grp>This pane\u2019s change</div>' + rows(associated, 'active');\n  }\n  if (suggested.length) {\n    html += '<div class=grp>Suggested for this pane (' + suggested.length + ')</div>' + rows(suggested, 'suggested');\n  }\n  var anchored = associated.length || suggested.length;\n  if (rest.length) {\n    if (anchored) {\n      // Anchored on a relevant set: the remainder is secondary, so the relevant\n      // set is the cutoff and the whole inventory stays one tap away.\n      html += '<details class=more><summary>Other changes (' + rest.length + ')<span class=chev aria-hidden=true></span></summary>' +\n        '<div class=morebody>' + rows(rest, '') + '</div></details>';\n    } else if (rest.length > INLINE_MAX) {\n      // No anchor and a long inventory: dumping it inline buries the view, so it\n      // goes behind the same labelled one-tap disclosure. The notice above already\n      // said why nothing is prioritised \u2014 opening this opens no change.\n      html += '<details class=more><summary>Browse all ' + rest.length + ' changes<span class=chev aria-hidden=true></span></summary>' +\n        '<div class=morebody>' + rows(rest, '') + '</div></details>';\n    } else {\n      // A short list does not bury anything, so show it.\n      html += '<div class=grp>All changes</div>' + rows(rest, '');\n    }\n  }\n  var r = document.getElementById('r');\n  r.innerHTML = html;\n\n  // One change open at a time (global), and one phase open at a time within a\n  // change. `toggle` does not bubble, so the listener captures. Closing a sibling\n  // programmatically fires another toggle with open=false, which this ignores.\n  // The inventory disclosure is neither, so opening it opens no change.\n  r.addEventListener('toggle', function (e) {\n    var t = e.target;\n    if (t.nodeName !== 'DETAILS' || !t.open) return;\n    if (t.classList.contains('change')) {\n      r.querySelectorAll('details.change[open]').forEach(function (o) { if (o !== t) o.open = false; });\n    } else if (t.classList.contains('phase')) {\n      var body = t.parentNode;\n      body.querySelectorAll('details.phase[open]').forEach(function (o) { if (o !== t) o.open = false; });\n    }\n  }, true);\n})();\n</script>\n<style>\n  /* Sizes are em-relative so host text scaling moves the whole hierarchy, and no\n     box is given a fixed height \u2014 at 200% every record just grows taller. */\n  /* The host wrapper does not set this, and a record's own padding + outline\n     would otherwise add to a full-width block and push the page sideways. */\n  #r, #r *, #r *::before, #r *::after { box-sizing: border-box; }\n  #r { -webkit-user-select: text; user-select: text; -webkit-touch-callout: default;\n       overflow-wrap: anywhere; }\n\n  /* State tints. Amber/green are STATE colours, not brand colours; every state\n     they mark also carries an icon and a word, so colour is never load-bearing.\n     The `light-dark()` pair darkens them for the host's light theme; an engine\n     that lacks it keeps the dark-theme value from the declaration above. */\n  #r { --w: #d29922; --ok: #3fb950;\n       --fill: color-mix(in srgb, var(--bd-fg) 4%, transparent);\n       --line2: color-mix(in srgb, var(--bd-line) 70%, transparent); }\n  #r { --w: light-dark(#8a6100, #d29922); --ok: light-dark(#1a7f37, #3fb950); }\n\n  /* --- zone 1: project summary --- */\n  .sum { color: var(--bd-muted); font-size: .92em; }\n  .sum .dot { opacity: .55; }\n\n  /* --- zone 2: context notice --- */\n  .notice { margin: 6px 0 14px; color: var(--bd-muted); font-size: .85em; line-height: 1.45; }\n\n  .empty { color: var(--bd-muted); margin-top: 10px; }\n  .dbg { font-size: .78em; opacity: .7; word-break: break-all; }\n  code { font-family: ui-monospace, monospace; }\n\n  /* --- zone 3: groups --- */\n  .grp { margin: 18px 0 8px; font-size: .85em; font-weight: 600; color: var(--bd-muted); }\n\n  /* --- the change record --- */\n  .crow, details.change {\n    display: block; margin: 0 0 12px; padding: 10px 12px;\n    border: 1px solid var(--bd-line); border-radius: var(--bd-radius-md);\n    background: transparent; background: var(--fill);\n  }\n  details.change > summary.crow {\n    margin: 0; padding: 0; border: 0; background: none;\n    list-style: none; cursor: pointer; min-height: 48px;\n  }\n  details.change > summary::-webkit-details-marker { display: none; }\n  .crow.flat { cursor: default; }\n  .change.active, .crow.active { border-color: color-mix(in srgb, var(--bd-primary) 55%, var(--bd-line)); }\n\n  .idn { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 8px; }\n  .nm { font-weight: 600; overflow-wrap: anywhere; flex: 1 1 60%; }\n  .ct { margin-left: auto; color: var(--bd-muted); font-variant-numeric: tabular-nums;\n        font-size: .9em; flex: 0 0 auto; }\n  .badge { font-size: .78em; padding: 1px 6px; border-radius: var(--bd-radius-sm); flex: 0 0 auto;\n           background: color-mix(in srgb, var(--bd-primary) 18%, transparent); color: var(--bd-primary); }\n\n  .bar { height: 3px; margin: 8px 0 8px; background: var(--bd-line);\n         border-radius: var(--bd-radius-sm); overflow: hidden; }\n  .bar i { display: block; height: 100%; background: var(--bd-primary); }\n  .bar i.ok { background: var(--ok); }\n\n  /* --- attention block --- */\n  .att { display: flex; gap: 7px; align-items: flex-start; margin-top: 6px;\n         padding: 6px 8px; border-radius: var(--bd-radius-sm); font-size: .92em; line-height: 1.4;\n         background: color-mix(in srgb, var(--bd-fg) 5%, transparent); }\n  .att .ico { flex: 0 0 auto; font-size: .95em; line-height: 1.5; }\n  .att .at { min-width: 0; overflow-wrap: anywhere; }\n  .att .lab { font-weight: 600; margin-right: 6px; }\n  .att.is-warn { background: color-mix(in srgb, var(--w) 15%, transparent); }\n  .att.is-warn .ico, .att.is-warn .lab { color: var(--w); }\n  .att.is-ok { background: color-mix(in srgb, var(--ok) 13%, transparent); }\n  .att.is-ok .ico, .att.is-ok .lab { color: var(--ok); }\n  .att.is-info { color: var(--bd-muted); }\n\n  .meta { margin-top: 4px; font-size: .85em; color: var(--bd-muted);\n          font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }\n  .why { margin-top: 5px; font-size: .85em; color: var(--bd-primary); overflow-wrap: anywhere; }\n\n  /* --- expanded detail: inside the record, separated by a rule, never a card --- */\n  .body { margin-top: 10px; padding-top: 6px; border-top: 1px solid var(--bd-line); }\n  .note { margin: 8px 0; padding: 7px 9px; border-radius: var(--bd-radius-sm);\n          background: color-mix(in srgb, var(--bd-muted) 12%, transparent);\n          color: var(--bd-muted); font-size: .85em; overflow-wrap: anywhere; }\n  .note.warn { color: var(--w); background: color-mix(in srgb, var(--w) 13%, transparent); }\n\n  details.phase > summary, .rollup {\n    /* Baseline, not centre: at large text a phase title wraps to three lines and\n       a centred glyph/count would float against its middle. */\n    display: flex; align-items: baseline; gap: 8px; min-height: 48px; padding: 13px 0;\n    border-top: 1px solid var(--line2); font-size: .95em;\n  }\n  details.phase > summary { cursor: pointer; list-style: none; }\n  details.phase > summary::-webkit-details-marker { display: none; }\n  .pg { flex: 0 0 auto; color: var(--bd-muted); }\n  .pt { flex: 1 1 auto; min-width: 0; overflow-wrap: anywhere; }\n  .pc { flex: 0 0 auto; color: var(--bd-muted); font-size: .88em; font-variant-numeric: tabular-nums; }\n  .tasks { padding: 2px 0 6px; }\n  .task { display: flex; gap: 7px; font-size: .95em; padding: 5px 0 5px 10px;\n          border-left: 2px solid var(--line2); margin-left: 3px; }\n  .task .g { color: var(--bd-muted); flex: 0 0 auto; }\n  .task .g.ok { color: var(--ok); }\n  .task .tt { min-width: 0; overflow-wrap: anywhere; }\n  .tag { font-size: .8em; font-weight: 600; padding: 0 5px; border-radius: 3px; white-space: nowrap; }\n  .tag.warn { color: var(--w); background: color-mix(in srgb, var(--w) 16%, transparent); }\n  .ann { font-size: .85em; color: var(--bd-muted); margin-top: 3px; overflow-wrap: anywhere; }\n  .ann.warn { color: var(--w); }\n\n  /* --- the inventory disclosure --- */\n  /* Collapsing the inventory is what the ordering spec asks for, but a bare bold\n     line on an otherwise empty sheet reads as a dead end. Giving the disclosure\n     a record's own outline makes it read as the control it is. */\n  .more { display: block; margin-top: 8px; }\n  .more > summary { display: flex; align-items: center; gap: 8px; min-height: 48px;\n    padding: 10px 12px; border: 1px solid var(--bd-line); border-radius: var(--bd-radius-md);\n    background: transparent; background: var(--fill);\n    cursor: pointer; list-style: none; font-size: .92em; font-weight: 600; }\n  .more > summary::-webkit-details-marker { display: none; }\n  .morebody { padding-top: 12px; }\n\n  /* --- disclosure affordance: only expandable things get a chevron --- */\n  .chev { flex: 0 0 auto; width: 0; height: 0; align-self: center;\n          border-left: 5px solid currentColor; border-top: 4px solid transparent;\n          border-bottom: 4px solid transparent; opacity: .6;\n          transition: transform 180ms ease; transform-origin: 30% 50%; }\n  .more > summary .chev { margin-left: auto; }\n  details[open] > summary .chev { transform: rotate(90deg); }\n  @media (prefers-reduced-motion: reduce) { .chev { transition: none; } }\n\n  summary:focus-visible { outline: 2px solid var(--bd-primary); outline-offset: 2px;\n                          border-radius: var(--bd-radius-sm); }\n</style>"
    },
    "data": {
      "report": ""
    },
    "context": {
      "version": 1,
      "keys": [
        "surface.summary"
      ]
    },
    "rank": {
      "candidates": "changes",
      "id": "name",
      "text": "name",
      "query": "surface.summary"
    }
  },
  "popup": {
    "title": {
      "const": "OpenSpec"
    },
    "summary": {
      "template": "{0} active change(s)",
      "args": [
        {
          "report": "open_changes"
        }
      ]
    },
    "empty_state": {
      "const": "No active changes in this project."
    },
    "rows": {
      "items_from": "changes",
      "max_rows": 24,
      "row": {
        "key": {
          "report": "name"
        },
        "primary": {
          "report": "name"
        },
        "secondary": {
          "report": "status"
        },
        "progress": {
          "current": {
            "report": "completed_tasks"
          },
          "total": {
            "report": "total_tasks"
          }
        }
      }
    }
  }
}
