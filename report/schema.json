{
  "$comment": "benchday.openspec.report/1 \u2014 the canonical OpenSpec project report payload.",
  "type": "object",
  "properties": {
    "open_changes": {
      "type": "integer",
      "description": "count of in-flight changes"
    },
    "cli_available": {
      "type": "boolean",
      "description": "a compatible openspec CLI produced structured output this evaluation"
    },
    "changes": {
      "type": "array",
      "maxItems": 32,
      "description": "bounded per-change state; task counts, not artifact bodies",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "completed_tasks": {
            "type": "integer"
          },
          "total_tasks": {
            "type": "integer"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "validation_ok": {
      "type": "boolean",
      "description": "result of the most recent validate action, when one has run"
    },
    "active_change": {
      "type": [
        "string",
        "null"
      ],
      "description": "the change this pane is working on, ONLY when its cwd is genuinely inside openspec/changes/<name>; null otherwise (never inferred from sharing a repo)"
    },
    "task_outlines": {
      "type": "array",
      "maxItems": 32,
      "description": "bounded per-change checklist projection parsed from tasks.md (phase rollups + next-attention); NEVER raw task bodies. Joined to `changes` by name on the client.",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "task_detail_status": {
            "type": "string",
            "description": "available | absent | unparseable | truncated | read_error"
          },
          "phases": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer"
                },
                "title": {
                  "type": "string"
                },
                "checked": {
                  "type": "integer"
                },
                "total": {
                  "type": "integer"
                },
                "verify_pending": {
                  "type": "integer"
                },
                "partial": {
                  "type": "integer"
                },
                "blocked": {
                  "type": "integer"
                }
              }
            }
          },
          "next_attention": {
            "type": [
              "object",
              "null"
            ],
            "description": "the one item deserving attention: {task_id, phase_index, kind (blocked|verify|partial|next), checked, text}; null when all tasks are checked",
            "properties": {
              "task_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "phase_index": {
                "type": "integer"
              },
              "kind": {
                "type": "string"
              },
              "checked": {
                "type": "boolean"
              },
              "text": {
                "type": "string"
              }
            }
          },
          "verify_pending": {
            "type": "integer"
          },
          "blocked": {
            "type": "integer"
          }
        }
      }
    },
    "focused_task_detail": {
      "type": [
        "object",
        "null"
      ],
      "description": "the FULL parsed checklist for the single associated change only (cwd genuinely inside its dir); null otherwise. Bounded to 64 tasks.",
      "properties": {
        "name": {
          "type": "string"
        },
        "tasks": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "phase_index": {
                "type": "integer"
              },
              "checked": {
                "type": "boolean"
              },
              "state": {
                "type": "string",
                "description": "open | checked | unverified | partial | blocked"
              },
              "text": {
                "type": "string"
              },
              "annotations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "active_change_completed": {
      "type": [
        "integer",
        "null"
      ],
      "description": "tasks completed in `active_change`; null when no change is associated"
    },
    "active_change_total": {
      "type": [
        "integer",
        "null"
      ],
      "description": "total tasks in `active_change`; null when no change is associated"
    }
  },
  "required": [
    "open_changes"
  ]
}